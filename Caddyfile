api.veraxi.me {
    log {
        output stdout
    }

    # Route all /api/* requests to the FastAPI backend
    reverse_proxy /api/* backend:8000
    
    # Route everything else to the Flutter Web (Nginx) container
    reverse_proxy /* web:80
}

# Android emulator viewer — ws-scrcpy streams the Redroid container to the browser
android.veraxi.me {
    log {
        output stdout
    }

    reverse_proxy localhost:8081
}
