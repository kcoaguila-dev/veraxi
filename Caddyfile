api.veraxi.me {
    log {
        output stdout
    }

    # Route all backend endpoints (REST API, MCP SSE transport, and OpenAPI docs)
    reverse_proxy /api/* backend:8000
    reverse_proxy /sse* backend:8000
    reverse_proxy /messages* backend:8000
    reverse_proxy /docs* backend:8000
    reverse_proxy /openapi.json backend:8000
    
    # Route everything else to the Flutter Web (Nginx) container
    reverse_proxy /* web:80
}

# Android emulator viewer — ws-scrcpy streams the Redroid container to the browser
android.veraxi.me {
    log {
        output stdout
    }

    reverse_proxy localhost:8081
}
