# Neo4j (Local container or Cloud e.g. neo4j+s://xxxx.databases.neo4j.io)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_local_password

# Qdrant (Local container, Cloud https://xxxx.cloud.qdrant.io, or Embedded path ./data/qdrant or :memory:)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=veraxi_docs

# LLM API
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=

# Ingestion & Embeddings (Preset Profile + Optional Granular Overrides)
INGESTION_PROFILE=lite # Options: lite (220MB MiniLM-L12 multilingual + pypdf), balanced (1GB mpnet multilingual + docling), high_accuracy (1.1GB Qwen3-0.6B-Q multilingual + docling)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Uncomment any of the 4 lines below to override INGESTION_PROFILE defaults with your own custom model/parser:
# EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# SPARSE_EMBEDDING_MODEL_NAME=Qdrant/bm25 # Options: Qdrant/bm25 (10MB multilingual), prithivida/Splade_PP_en_v1 (532MB English neural expansion)
# EMBEDDING_DIMENSION=384
# DOCUMENT_PARSER=pypdf # Options: pypdf (fast low-RAM), docling (layout/tables)
EMBEDDING_THREADS=2
ENTITY_RESOLUTION_THRESHOLD=0.90
WORKER_MODE=inline # Options: inline (in-process background task), arq (separate worker container)

# Deployment Mode
AUTH_ENABLED=true # Set to false to bypass Supabase login for local single-user mode
INTERNAL_API_URL=http://localhost:8000/api # URL used by internal MCP server to call main backend (override for Docker/K8s)

# Sentry
SENTRY_DSN=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Web Search (CRAG)
# Note: Ensure 'json' is enabled under search.formats in your SearXNG settings.yml, otherwise you will get a 403 Forbidden.
SEARXNG_URL="http://localhost:8080/search"

# Redis Infrastructure (for Background tasks and LangGraph Memory)
REDIS_URL=redis://localhost:6379/0

# LangSmith Observability (LangGraph Agent Tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="veraxi-production"

# Rate Limits
RATE_LIMIT_CHAT=100/day
RATE_LIMIT_INGEST=50/day
RATE_LIMIT_SSE=10/minute

# --- Retrieval & Precision Tuning (CPU-Bound RAG) ---
# Fallback limits if the LLM doesn't explicitly specify them
DEFAULT_SEARCH_LIMIT=10
DEFAULT_MAX_HOPS=2

# Qdrant INT8 Scalar Quantization & Hybrid Search Over-fetching
QDRANT_QUANTIZATION=true # Enable INT8 vector quantization for 4x RAM compression & fast AVX-512 SIMD
QDRANT_RESCORE_OVERSAMPLING=2.0 # Oversampling factor for FP32 rescoring of quantized HNSW vector candidates
QDRANT_PREFETCH_MULTIPLIER=2 # Depth multiplier (max(limit * multiplier, 20)) for hybrid Dense + BM25 RRF fusion

# Cross-Encoder Reranking (ONNX runtime via fastembed)
RERANKER_ENABLED=true # Enabled by default; set to false to disable CPU ONNX cross-encoder reranking on top fused candidates
RERANKER_MODEL_NAME="Xenova/ms-marco-MiniLM-L-6-v2" # Tiny 80MB ONNX cross-encoder (English-centric; for multilingual corpora, use "jinaai/jina-reranker-v2-base-multilingual" or "BAAI/bge-reranker-base")

# Near-Duplicate Suppression (Diversity / MMR token overlap threshold)
NEAR_DUPLICATE_THRESHOLD=0.75 # Jaccard similarity threshold for suppressing duplicate paragraphs across editions

CORS_ORIGINS="https://veraxi.me,http://localhost:6333,http://localhost:3000"

# External Integrations & Connectors
INTEGRATION_ENCRYPTION_KEY= # Fernet key (or passphrase) for encrypting integration secrets at rest; REQUIRED in production
ALLOW_PRIVATE_MCP_URLS=false # Set true only for local self-hosted MCP dev (bypasses SSRF private-IP rejection)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL= # Public base URL of this backend for OAuth callbacks (defaults to PUBLIC_APP_URL host when empty)

# Hybrid Agentic Coding Sandboxes
SANDBOX_ENABLED=true
SANDBOX_DEFAULT_PROVIDER=disabled # disabled | modal | e2b | remote_mcp | local_runner
SANDBOX_IDLE_TIMEOUT_SEC=900
SANDBOX_MAX_SESSION_SEC=3600
SANDBOX_DEFAULT_CPU_CORES=2
SANDBOX_DEFAULT_MEMORY_MB=4096
SANDBOX_DEFAULT_DISK_GB=10
SANDBOX_DEFAULT_BASE_IMAGE=polyglot # python | node | flutter | polyglot
SANDBOX_DEFAULT_AUTONOMY_MODE=auto_read_test # ask_all | auto_read_test | autonomous
SANDBOX_DEFAULT_EGRESS_MODE=allowlist # offline | allowlist | unrestricted
SANDBOX_EXEC_TIMEOUT_SEC=120
# Per-tenant provider tokens (MODAL_TOKEN_ID/MODAL_TOKEN_SECRET, E2B_API_KEY,
# runner/MCP bearer tokens) are NOT global env vars: they are stored per
# tenant, Fernet-encrypted via INTEGRATION_ENCRYPTION_KEY, in
# tenant_sandbox_configs.encrypted_secrets.

# External ACP Agent Runtimes (e.g. Google Antigravity CLI `agy acp`)
ACP_ENABLED=false # Set true in self-hosted local mode to allow local `agy acp` sessions
ANTIGRAVITY_ACP_BIN=agy
ANTIGRAVITY_DATA_DIR=
ACP_IDLE_TIMEOUT_SEC=900
ACP_MAX_SESSIONS_PER_TENANT=3
