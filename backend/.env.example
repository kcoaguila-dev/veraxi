# Neo4j (Local container or Cloud e.g. neo4j+s://xxxx.databases.neo4j.io)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_local_password

# Qdrant (Local container, Cloud https://xxxx.cloud.qdrant.io, or Embedded path ./data/qdrant or :memory:)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=veraxi_docs

# LLM API
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=

# Ingestion & Embeddings (Preset Profile + Optional Granular Overrides)
INGESTION_PROFILE=lite # Options: lite (220MB MiniLM-L12 multilingual + pypdf), balanced (1GB mpnet multilingual + docling), high_accuracy (1.1GB Qwen3-0.6B-Q multilingual + docling)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Uncomment any of the 4 lines below to override INGESTION_PROFILE defaults with your own custom model/parser:
# EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# SPARSE_EMBEDDING_MODEL_NAME=Qdrant/bm25 # Options: Qdrant/bm25 (10MB multilingual), prithivida/Splade_PP_en_v1 (532MB English neural expansion)
# EMBEDDING_DIMENSION=384
# DOCUMENT_PARSER=pypdf # Options: pypdf (fast low-RAM), docling (layout/tables)
EMBEDDING_THREADS=2
ENTITY_RESOLUTION_THRESHOLD=0.90
WORKER_MODE=inline # Options: inline (in-process background task), arq (separate worker container)

# Deployment Mode
AUTH_ENABLED=true # Set to false to bypass Supabase login for local single-user mode
INTERNAL_API_URL=http://localhost:8000/api # URL used by internal MCP server to call main backend (override for Docker/K8s)

# Sentry
SENTRY_DSN=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Web Search (CRAG)
# Note: Ensure 'json' is enabled under search.formats in your SearXNG settings.yml, otherwise you will get a 403 Forbidden.
SEARXNG_URL="http://localhost:8080/search"

# Redis Infrastructure (for Background tasks and LangGraph Memory)
REDIS_URL=redis://localhost:6379/0

# LangSmith Observability (LangGraph Agent Tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="veraxi-production"

# Rate Limits
RATE_LIMIT_CHAT=100/day
RATE_LIMIT_INGEST=50/day
RATE_LIMIT_SSE=10/minute

# --- Retrieval Tuning ---
# Fallback limits if the LLM doesn't explicitly specify them
DEFAULT_SEARCH_LIMIT=10
DEFAULT_MAX_HOPS=2
CORS_ORIGINS="https://veraxi.me,http://localhost:6333,http://localhost:3000"
